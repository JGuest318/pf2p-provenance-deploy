# PF2P_PROVENANCE — Phase 1 environment template
# Copy this file to ".env" in the same directory as docker-compose.yml
# and fill in the real values BEFORE running `docker compose up`.
# Never commit the filled-in ".env" to source control.

# --- Tailscale IPv4 address of THIS NAS ---
# Resolve with:  tailscale ip -4
# Must be the actual tailnet address assigned to the DXP480T Plus.
# Do NOT use 100.64.0.0 or any other CGNAT range prefix — that is a
# network range, not a host address.
TAILSCALE_IP=100.x.y.z

# --- pf2p-svc service account identity ---
# Resolve with:  id pf2p-svc
# Must match EXACTLY what that command returns. Do not assume 1101:1101 —
# verify it on this specific NAS before filling these in.
PF2P_SVC_UID=REPLACE_WITH_VERIFIED_UID
PF2P_SVC_GID=REPLACE_WITH_VERIFIED_GID
